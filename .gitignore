# ==================== Python 运行时产物 ====================
__pycache__/
*.py[cod]
*$py.class
*.so
.claude/

# ==================== 虚拟环境 ====================
.venv/
venv/
env/

# ==================== IDE / 编辑器 ====================
.idea/
.qodo/
.vscode/

# ==================== 数据集 ====================
# MNIST 下载缓存体积较大，不入库，首次运行 train.py 会自动重新下载
data/

# ==================== 模型权重 ====================
# 权重由 train.py 生成，不入库
models/*.pt
models/*.pth

# ==================== 训练产出 ====================
# 默认排除训练产物，但曲线/混淆矩阵/分类报告是面试展示材料，需放行提交。
# 注意：反向规则必须紧跟被排除的目录，且父目录要先被排除再放行。
reports/
!reports/
!reports/*.png
!reports/*.txt

# 其他临时预览图（非展示材料）不入库
reports/*.tmp.png

# ==================== 测试与覆盖率 ====================
.pytest_cache/
.coverage
htmlcov/

# ==================== 打包产物 ====================
build/
dist/
*.egg-info/

# ==================== 操作系统 ====================
Thumbs.db
Desktop.ini
.DS_Store

# ==================== 内部文档 ====================
# 阶段任务单（开发过程用）
TASK0.md
TASK1.md
TASK2.md
TASK3.md
TASK4.md
TASK5.md
TASK6.md
TASK7.md
TASK8.md
TASK9.md

